# AI Engineering Platform - Environment Configuration
# Copy this file to .env and customize for your environment

# ============================================================================
# NODE & RUNTIME
# ============================================================================
NODE_ENV=development
NODE_OPTIONS=--disable-warnings
LOG_LEVEL=debug
DEBUG=

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
# Connection details for PostgreSQL database
DB_USER=aiep_user
DB_PASSWORD=aiep_password
DB_NAME=aiep_dev
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgres://aiep_user:aiep_password@postgres:5432/aiep_dev

# ============================================================================
# CACHE & SESSION (Redis)
# ============================================================================
# Connection details for Redis cache and session store
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=aiep_redis_secret
REDIS_URL=redis://:aiep_redis_secret@redis:6379/0

# ============================================================================
# VECTOR DATABASE (Weaviate)
# ============================================================================
# Connection details for Weaviate vector database
WEAVIATE_HOST=weaviate
WEAVIATE_PORT=8080
WEAVIATE_URL=http://weaviate:8080

# ============================================================================
# MESSAGE BROKER (Kafka)
# ============================================================================
# Kafka broker configuration for event streaming
KAFKA_BROKERS=kafka:29092
KAFKA_HOST=kafka
KAFKA_PORT=9092
KAFKA_CONSUMER_GROUP=aiep-consumers

# ============================================================================
# ORCHESTRATION API
# ============================================================================
# Orchestration API server configuration
ORCHESTRATION_PORT=8787
ORCHESTRATION_HOST=0.0.0.0
ORCHESTRATION_SHARED_STATE_URL=http://localhost:8790

# ============================================================================
# SHARED STATE SERVICE
# ============================================================================
# Shared state service configuration
ORCHESTRATION_STATE_PORT=8790
ORCHESTRATION_STATE_HOST=0.0.0.0
ORCHESTRATION_STATE_API_KEY=your-api-key-here

# ============================================================================
# LLM SERVICES - OpenAI
# ============================================================================
# OpenAI API configuration for model access
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4-turbo
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# ============================================================================
# LLM SERVICES - Anthropic
# ============================================================================
# Anthropic (Claude) API configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-opus
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=2000

# ============================================================================
# LLM SERVICES - Other Providers (Optional)
# ============================================================================
# Azure OpenAI configuration (optional)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=

# Cohere API (optional)
COHERE_API_KEY=

# Hugging Face API (optional)
HUGGINGFACE_API_KEY=

# ============================================================================
# ROUTER KNOWLEDGE STORE
# ============================================================================
# Local persistence + lexical lookup work without API keys.
# OpenAI/Anthropic are optional enhancements for enrichment and re-scoring.
ROUTER_KNOWLEDGE_WEAVIATE_INDEX_ENABLED=true
ROUTER_KNOWLEDGE_EMBEDDING_ORDER=local,openai
ROUTER_KNOWLEDGE_LOCAL_EMBEDDING_URL=http://host.docker.internal:11434/api/embeddings
ROUTER_KNOWLEDGE_LOCAL_EMBEDDING_MODEL=nomic-embed-text
ROUTER_KNOWLEDGE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ROUTER_KNOWLEDGE_ANTHROPIC_SCORING_ENABLED=false
ROUTER_KNOWLEDGE_LOCAL_STORE_PATH=

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# JWT and authentication configuration
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRY=7d
API_KEY_HEADER=x-api-key

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# CORS configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
CORS_CREDENTIALS=true

# ============================================================================
# OBSERVABILITY & MONITORING
# ============================================================================
# Logging and monitoring configuration
LOG_FORMAT=json
LOG_TRANSPORT=console,file

# Application Performance Monitoring (APM)
APM_ENABLED=false
APM_SERVICE_NAME=aiep
APM_SERVER_URL=http://localhost:8200

# Tracing configuration
TRACING_ENABLED=false
TRACING_SAMPLE_RATE=0.1

# Metrics
METRICS_ENABLED=false
METRICS_PORT=9090

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Feature flag controls
FEATURE_CANARY_ROUTING=false
FEATURE_ADVANCED_WEIGHTING=false
FEATURE_ADAPTIVE_TUNING=false

# ============================================================================
# DEPLOYMENT & ENVIRONMENT
# ============================================================================
# Deployment-specific settings
ENVIRONMENT=local
DEPLOYMENT_REGION=local
DEPLOYMENT_VERSION=dev

# ============================================================================
# SERVICE DISCOVERY (Optional)
# ============================================================================
# Service mesh and discovery configuration
SERVICE_MESH_ENABLED=false
SERVICE_DISCOVERY_TYPE=local

# ============================================================================
# EXTERNAL INTEGRATIONS (Optional)
# ============================================================================
# Webhook URLs and external service connections
WEBHOOK_RETRY_ENABLED=true
WEBHOOK_MAX_RETRIES=3
WEBHOOK_TIMEOUT_MS=10000

# Slack integration (for notifications)
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=

# GitHub integration (for CI/CD webhooks)
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# ============================================================================
# DATA & PERSISTENCE
# ============================================================================
# Data retention and backup settings
DATA_RETENTION_DAYS=30
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *

# ============================================================================
# DEVELOPMENT & DEBUG
# ============================================================================
# Development-only settings (do NOT use in production)
MOCK_LLM_RESPONSES=false
SEED_TEST_DATA=false
VERBOSE_LOGGING=false
INSPECT_REQUESTS=false
